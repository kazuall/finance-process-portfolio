---
config:
  theme: base
  htmlLabels: false
  themeVariables:
    darkMode: true
    background: transparent
    fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif'
    fontSize: '14px'
    primaryTextColor: '#e6edf3'
    lineColor: '#64748b'
    textColor: '#e6edf3'
    edgeLabelBackground: '#141a24'
    clusterBkg: '#141a24'
    clusterBorder: '#303d52'
  flowchart:
    htmlLabels: false
    useMaxWidth: false
    nodeSpacing: 30
    rankSpacing: 42
    padding: 14
    diagramPadding: 10
    curve: basis
  themeCSS: 'text{font-family: Inter, "Segoe UI", Arial, sans-serif;}.node rect.label-container{rx:8px;ry:8px}.cluster rect{rx:8px;ry:8px}.edgeLabel .labelBkg{fill:#141a24 !important}.edgeLabel text{fill:#c5d2e4 !important}.cluster-label text{fill:#c5d2e4 !important;font-weight:600}'
---
flowchart LR
  mail(["Saved mail<br/>and invitations"]):::source --> extract["Local extraction<br/>NuExtract"]:::process
  extract --> cal["Check times<br/>and event version"]:::check
  extract --> app["Check source quote<br/>and application role"]:::check
  cal -->|Changed| write["Write and<br/>read back"]:::output
  cal -->|Current| noop["Skip calendar write"]:::process
  app -->|Verified decision| journal["SQLite journal<br/>Tracker views"]:::output
  cal -. Ambiguous .-> human["Human review"]:::human
  app -. Ambiguous .-> human
  classDef source fill:#162436,stroke:#5b8ec9,color:#e6edf3,stroke-width:1.25px
  classDef process fill:#18202c,stroke:#3b4960,color:#e6edf3,stroke-width:1.25px
  classDef check fill:#231d33,stroke:#9b87d4,color:#ede9fe,stroke-width:1.25px
  classDef human fill:#2e2415,stroke:#d99b43,color:#fef3c7,stroke-width:1.25px,stroke-dasharray:4 3
  classDef output fill:#132a24,stroke:#3fb98b,color:#d1fae5,stroke-width:1.25px
