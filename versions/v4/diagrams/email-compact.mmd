config:
  theme: base
  htmlLabels: false
  themeVariables:
    darkMode: true
    background: '#101010'
    fontFamily: 'Inter, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif'
    fontSize: '16px'
