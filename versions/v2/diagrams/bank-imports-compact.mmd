flowchart TB
  subgraph bank["Bank import"]
    direction TB
    file(["Backup + import<br/>by stable row ID"]):::feed --> receipt{{"Receipt<br/>matches?"}}:::check
    receipt -->|Yes| done["Verify archive"]:::confirmed
    receipt -->|Unclear| pause["Pause<br/>and inspect"]:::review
  end
  subgraph admin["Document intake"]
    direction TB
    doc(["Check document<br/>fingerprint"]):::feed --> check{{"Type<br/>supported?"}}:::check
    check -->|Yes| classify["Classify"]:::confirmed
    check -->|Unclear| review["Visual review"]:::review
  end
  bank ~~~ admin
